mdl 1;
-- =============================================================================
-- TripPlanning: safe start, hard stop, bay list and stop minutes per vendor+slot
-- (all in microflows; no Java except the tiny MinutesFromSlot in the live script)
-- Mirrors trip_demand_analysis.py (Bay schedule tab). Apply with mxcli:
--
--   mxcli check mendix/tripplanning.mdl
--   mxcli -p App.mpr -c "execute script 'mendix/tripplanning.mdl'"
--
-- Close Studio Pro first and commit your project before running.
-- =============================================================================

create module TripPlanning;

-- MARK: SETTINGS -------------------------------------------------------------

/** One row. Every number the plan depends on, editable by the yard lead. */
@position(100, 100)
create persistent entity TripPlanning.PlanSettings (
  HistoryWeeks: integer not null default 10,
  /** Safe start = this share of a vendor's trucks have arrived (0.80 = P80) */
  QStart: decimal not null default 0.80,
  /** Hard stop = this share arrived (0.95 = P95) plus GraceMin */
  QStop: decimal not null default 0.95,
  GraceMin: integer not null default 15,
  RoundMin: integer not null default 15,
  /** Fewer trucks than this in a slot: use the slot-wide timing instead */
  MinTrucks: integer not null default 10,
  /** Vendor-slots running on fewer % of days are not planned */
  MinRunPct: integer not null default 20,
  AllowancePct: integer not null default 15,
  FixedMin: integer not null default 5,
  /** Stop minutes sized on this percentile of past days (0.75 = P75) */
  QStopMinutes: decimal not null default 0.75,
  ManualMin: integer not null default 25,
  GapMin: integer not null default 5,
  EarlyCapH: integer not null default 12,
  LateCapH: integer not null default 12
);

-- MARK: INPUTS ---------------------------------------------------------------

/** One row per schedule line x truck, same as nagare_data.parquet */
@position(400, 100)
create persistent entity TripPlanning.GateEntry (
  TruckId: string(30) not null,
  Vendor: string(20) not null,
  /** hh:mm */
  Slot: string(5) not null,
  SupplyDate: datetime not null,
  GateIn: datetime,
  GateOut: datetime,
  Bay: string(20),
  Item: string(40),
  ReceivedQty: decimal,
  PlannedQty: decimal,
  ScheduleNo: string(30)
)
index (SupplyDate)
index (Vendor, Slot);

/** Pack size and standard unloading time per item */
@position(700, 100)
create persistent entity TripPlanning.ItemStandard (
  Item: string(40) not null unique,
  PackSize: decimal,
  StdMinutes: decimal,
  /** per pack | per piece | per stop */
  Basis: string(20) default 'per pack',
  IsCritical: boolean default false
);

@position(1000, 100)
create persistent entity TripPlanning.Bay (
  Code: string(20) not null unique,
  IsHotLane: boolean default false,
  /** Set by the bay occupancy feed */
  Occupied: boolean default false,
  /** Held for a truck sent here, until its expected end plus the gap */
  ReservedUntil: datetime
);

-- MARK: OUTPUTS --------------------------------------------------------------

/** One row per vendor + slot (+ weekday) per plan version */
@position(400, 400)
create persistent entity TripPlanning.VendorSlotPlan (
  Vendor: string(20) not null,
  Slot: string(5) not null,
  /** 'All' or MONDAY..SUNDAY */
  DayOfWeek: string(10) not null default 'All',
  /** Minutes relative to the slot time; negative = before the slot */
  SafeStartOffset: integer not null,
  HardStopOffset: integer not null,
  /** Clock text, e.g. 09:15 or 00:10 (+1d) */
  SafeStart: string(12),
  HardStop: string(12),
  Basis: string(40),
  TrucksInHistory: integer,
  RunsPct: integer,
  PlanVersion: integer not null,
  GeneratedOn: datetime,
  IsActive: boolean default true
)
index (Vendor, Slot, IsActive);

/** Ordered bay stops of a plan row, with minutes per stop */
@position(700, 400)
create persistent entity TripPlanning.PlanStop (
  Sequence: integer not null,
  BayCode: string(20) not null,
  StopMinutes: integer not null,
  MinutesBasis: string(40),
  IsCritical: boolean default false,
  SharePct: integer
);

create association TripPlanning.PlanStop_VendorSlotPlan
  from TripPlanning.PlanStop to TripPlanning.VendorSlotPlan
  type reference on delete cascade;

create association TripPlanning.PlanStop_Bay
  from TripPlanning.PlanStop to TripPlanning.Bay
  type reference;

/** One line per decision the plan run makes, so a plan can be explained on a page */
@position(1000, 400)
create persistent entity TripPlanning.PlanRunLog (
  RunAt: datetime,
  PlanVersion: integer,
  /** 'run' or 'vendor | slot | day' */
  Scope: string(80),
  Message: string(500)
)
index (PlanVersion);

-- MARK: STAGING (rebuilt on every plan run) ----------------------------------

/** One gate entry (truck + entry time) with its minutes against the slot */
@position(100, 700)
create persistent entity TripPlanning.HistTrip (
  Vendor: string(20),
  Slot: string(5),
  SupplyDate: datetime,
  TruckId: string(30),
  GateIn: datetime,
  /** Minutes after the slot time; negative = before */
  OffsetMin: integer
)
index (Vendor, Slot, OffsetMin);

/** One bay stop of a gate entry, with standard unloading minutes */
@position(400, 700)
create persistent entity TripPlanning.HistStop (
  Vendor: string(20),
  Slot: string(5),
  Bay: string(20),
  StdMin: decimal default 0,
  QtyAll: decimal default 0,
  QtyStd: decimal default 0,
  HasCritical: boolean default false
)
index (Vendor, Slot, Bay, StdMin);

/** Trips per vendor + slot, and on how many days they ran */
@position(700, 700)
create persistent entity TripPlanning.VsGroup (
  Vendor: string(20),
  Slot: string(5),
  N: integer default 0,
  RunDays: integer default 0
);

/** Trips per slot over all vendors: the fallback for thin vendor history */
@position(1000, 700)
create persistent entity TripPlanning.SlotGroup (
  Slot: string(5),
  N: integer default 0
);

/** How often a vendor + slot uses a bay */
@position(1300, 700)
create persistent entity TripPlanning.BayShare (
  Vendor: string(20),
  Slot: string(5),
  Bay: string(20),
  Visits: integer default 0,
  QtyAll: decimal default 0,
  QtyStd: decimal default 0,
  HasCritical: boolean default false
);

-- MARK: MICROFLOWS -----------------------------------------------------------

/** The single settings row, created with defaults if missing */
create microflow TripPlanning.SUB_GetSettings ()
returns TripPlanning.PlanSettings as $Settings
folder 'Plan'
begin
  retrieve $Settings from TripPlanning.PlanSettings first;
  if $Settings = empty then
    $NewSettings = create TripPlanning.PlanSettings ();
    commit $NewSettings;
    return $NewSettings;
  end if;
  return $Settings;
end;

/** One line of explanation, shown on the Why-this-plan page */
create microflow TripPlanning.SUB_RunLog (
  $Version: integer,
  $Scope: string,
  $Message: string
)
folder 'Plan'
begin
  $L = create TripPlanning.PlanRunLog (
    RunAt = [%CurrentDateTime%],
    PlanVersion = $Version,
    Scope = $Scope,
    Message = $Message
  );
  commit $L;
  return;
end;

/** Slot hh:mm + offset minutes as clock text, e.g. 09:15 or 00:10 (+1d) */
create microflow TripPlanning.SUB_ClockText (
  $Slot: string,
  $Offset: integer
)
returns string as $Text
folder 'Plan'
begin
  declare $Total integer = parseInteger(substring($Slot, 0, 2)) * 60 + parseInteger(substring($Slot, 3, 2)) + $Offset;
  declare $Day integer = floor($Total / 1440);
  declare $Rest integer = $Total - $Day * 1440;
  declare $Hh integer = floor($Rest / 60);
  declare $Mm integer = $Rest - $Hh * 60;
  declare $HhText string = toString($Hh);
  declare $MmText string = toString($Mm);
  if $Hh < 10 then
    set $HhText = '0' + $HhText;
  end if;
  if $Mm < 10 then
    set $MmText = '0' + $MmText;
  end if;
  declare $Out string = $HhText + ':' + $MmText;
  if $Day > 0 then
    set $Out = $Out + ' (+' + toString($Day) + 'd)';
  end if;
  if $Day < 0 then
    set $Out = $Out + ' (' + toString($Day) + 'd)';
  end if;
  return $Out;
end;

/** The q-th percentile (0..1) of OffsetMin, read from the database in sorted order:
 *  no list is loaded, only the two neighbouring rows. */
create microflow TripPlanning.SUB_PercentileTrip (
  $Vendor: string,
  $Slot: string,
  $UseVendor: boolean,
  $N: integer,
  $Q: decimal
)
returns decimal as $Value
folder 'Plan'
begin
  declare $Pos decimal = $Q * ($N - 1);
  declare $Lo integer = floor($Pos);
  declare $Hi integer = ceil($Pos);
  declare $A decimal = 0;
  declare $B decimal = 0;
  if $UseVendor then
    retrieve $LoRows from TripPlanning.HistTrip
      where [Vendor = $Vendor and Slot = $Slot]
      sort by OffsetMin asc
      limit 1 offset $Lo;
    retrieve $HiRows from TripPlanning.HistTrip
      where [Vendor = $Vendor and Slot = $Slot]
      sort by OffsetMin asc
      limit 1 offset $Hi;
    declare $LoObj TripPlanning.HistTrip = head($LoRows);
    declare $HiObj TripPlanning.HistTrip = head($HiRows);
    set $A = $LoObj/OffsetMin;
    set $B = $HiObj/OffsetMin;
  else
    retrieve $LoAll from TripPlanning.HistTrip
      where [Slot = $Slot]
      sort by OffsetMin asc
      limit 1 offset $Lo;
    retrieve $HiAll from TripPlanning.HistTrip
      where [Slot = $Slot]
      sort by OffsetMin asc
      limit 1 offset $Hi;
    declare $LoAllObj TripPlanning.HistTrip = head($LoAll);
    declare $HiAllObj TripPlanning.HistTrip = head($HiAll);
    set $A = $LoAllObj/OffsetMin;
    set $B = $HiAllObj/OffsetMin;
  end if;
  return $A + ($B - $A) * ($Pos - $Lo);
end;

/** Same, for the standard unloading minutes of one vendor + slot + bay */
create microflow TripPlanning.SUB_PercentileStop (
  $Vendor: string,
  $Slot: string,
  $Bay: string,
  $N: integer,
  $Q: decimal
)
returns decimal as $Value
folder 'Plan'
begin
  declare $Pos decimal = $Q * ($N - 1);
  declare $Lo integer = floor($Pos);
  declare $Hi integer = ceil($Pos);
  retrieve $LoRows from TripPlanning.HistStop
    where [Vendor = $Vendor and Slot = $Slot and Bay = $Bay]
    sort by StdMin asc
    limit 1 offset $Lo;
  retrieve $HiRows from TripPlanning.HistStop
    where [Vendor = $Vendor and Slot = $Slot and Bay = $Bay]
    sort by StdMin asc
    limit 1 offset $Hi;
  declare $LoObj TripPlanning.HistStop = head($LoRows);
  declare $HiObj TripPlanning.HistStop = head($HiRows);
  return $LoObj/StdMin + ($HiObj/StdMin - $LoObj/StdMin) * ($Pos - $Lo);
end;

/** Step 1: turn GateEntry rows into trips (truck + entry time) and bay stops.
 *  Rows are read 5000 at a time, sorted by truck, entry time, bay. Returns trips kept. */
create microflow TripPlanning.SUB_BuildHistory (
  $Settings: TripPlanning.PlanSettings,
  $Version: integer
)
returns integer as $Kept
folder 'Plan'
begin
  retrieve $OldTrips from TripPlanning.HistTrip;
  delete $OldTrips;
  retrieve $OldStops from TripPlanning.HistStop;
  delete $OldStops;
  retrieve $Standards from TripPlanning.ItemStandard;

  declare $From datetime = addDays([%CurrentDateTime%], -7 * $Settings/HistoryWeeks);
  declare $EarlyMin integer = -60 * $Settings/EarlyCapH;
  declare $LateMin integer = 60 * $Settings/LateCapH;
  declare $Skip integer = 0;
  declare $More boolean = true;
  declare $LastTrip string = '';
  declare $LastStop string = '';
  declare $Read integer = 0;
  declare $Kept integer = 0;
  declare $Dropped integer = 0;
  declare $Trip TripPlanning.HistTrip = empty;
  declare $Stop TripPlanning.HistStop = empty;
  declare $Key string = '';
  declare $SlotMin integer = 0;
  declare $Off integer = 0;
  declare $RowMin decimal = 0;
  declare $RowStd decimal = 0;
  declare $Qty decimal = 0;
  declare $IsCrit boolean = false;

  while $More begin
    retrieve $Batch from TripPlanning.GateEntry
      where [SupplyDate >= $From and GateIn != empty]
      sort by TruckId asc, GateIn asc, Bay asc
      limit 5000 offset $Skip;
    if length($Batch) = 0 then
      set $More = false;
    else
      set $Skip = $Skip + 5000;
      loop $Row in $Batch begin
        set $Read = $Read + 1;
        set $Key = $Row/TruckId + '@' + toString($Row/GateIn);
        if $Key != $LastTrip then
          set $LastTrip = $Key;
          set $LastStop = '';
          if $Stop != empty then
            commit $Stop;
            set $Stop = empty;
          end if;
          set $SlotMin = parseInteger(substring($Row/Slot, 0, 2)) * 60 + parseInteger(substring($Row/Slot, 3, 2));
          set $Off = minutesBetween(addMinutes(trimToDays($Row/SupplyDate), $SlotMin), $Row/GateIn);
          if $Off >= $EarlyMin and $Off <= $LateMin then
            $NewTrip = create TripPlanning.HistTrip (
              Vendor = $Row/Vendor,
              Slot = $Row/Slot,
              SupplyDate = $Row/SupplyDate,
              TruckId = $Row/TruckId,
              GateIn = $Row/GateIn,
              OffsetMin = $Off
            );
            commit $NewTrip;
            set $Trip = $NewTrip;
            set $Kept = $Kept + 1;
          else
            set $Trip = empty;
            set $Dropped = $Dropped + 1;
          end if;
        end if;

        if $Trip != empty and $Row/Bay != empty then
          if $Row/Bay != $LastStop then
            if $Stop != empty then
              commit $Stop;
            end if;
            set $LastStop = $Row/Bay;
            $NewStop = create TripPlanning.HistStop (
              Vendor = $Row/Vendor,
              Slot = $Row/Slot,
              Bay = $Row/Bay
            );
            set $Stop = $NewStop;
          end if;
          -- standard unloading minutes of this row
          set $Qty = 0;
          if $Row/ReceivedQty != empty then
            set $Qty = $Row/ReceivedQty;
          end if;
          set $RowMin = 0;
          set $RowStd = 0;
          set $IsCrit = false;
          retrieve $Found from $Standards where Item = $Row/Item limit 1;
          declare $Match TripPlanning.ItemStandard = head($Found);
          if $Match != empty then
            if $Match/IsCritical = true then
              set $IsCrit = true;
            end if;
            if $Match/StdMinutes != empty then
              if $Match/Basis = 'per piece' then
                set $RowMin = $Qty * $Match/StdMinutes;
                set $RowStd = $Qty;
              elsif $Match/Basis = 'per stop' then
                if $Qty > 0 then
                  set $RowMin = $Match/StdMinutes;
                  set $RowStd = $Qty;
                end if;
              elsif $Match/PackSize != empty and $Match/PackSize > 0 then
                set $RowMin = ceil($Qty / $Match/PackSize) * $Match/StdMinutes;
                set $RowStd = $Qty;
              end if;
            end if;
          end if;
          change $Stop (
            StdMin = $Stop/StdMin + $RowMin,
            QtyAll = $Stop/QtyAll + $Qty,
            QtyStd = $Stop/QtyStd + $RowStd,
            HasCritical = $Stop/HasCritical or $IsCrit
          );
        end if;
      end loop;
    end if;
  end while;
  if $Stop != empty then
    commit $Stop;
  end if;

  call microflow TripPlanning.SUB_RunLog (
    Version = $Version,
    Scope = 'run',
    Message = 'Read ' + toString($Read) + ' gate-entry rows since ' + formatDateTime($From, 'yyyy-MM-dd')
      + ': ' + toString($Kept) + ' trips kept, ' + toString($Dropped)
      + ' dropped for arriving more than ' + toString($Settings/EarlyCapH) + 'h before or '
      + toString($Settings/LateCapH) + 'h after the slot; '
      + toString(length($Standards)) + ' item standards loaded.'
  );
  return $Kept;
end;

/** Step 2: trips per vendor + slot, per slot, bay usage, and days with any trucks.
 *  Returns the number of distinct days. */
create microflow TripPlanning.SUB_BuildGroups ()
returns integer as $AllDays
folder 'Plan'
begin
  retrieve $OldG from TripPlanning.VsGroup;
  delete $OldG;
  retrieve $OldS from TripPlanning.SlotGroup;
  delete $OldS;
  retrieve $OldB from TripPlanning.BayShare;
  delete $OldB;

  -- vendor + slot groups
  retrieve $Trips from TripPlanning.HistTrip sort by Vendor asc, Slot asc, SupplyDate asc;
  declare $G TripPlanning.VsGroup = empty;
  declare $LastV string = '';
  declare $LastS string = '';
  declare $LastD datetime = empty;
  loop $T in $Trips begin
    if $T/Vendor != $LastV or $T/Slot != $LastS then
      if $G != empty then
        commit $G;
      end if;
      $NewG = create TripPlanning.VsGroup (Vendor = $T/Vendor, Slot = $T/Slot, N = 0, RunDays = 0);
      set $G = $NewG;
      set $LastV = $T/Vendor;
      set $LastS = $T/Slot;
      set $LastD = empty;
    end if;
    change $G (N = $G/N + 1);
    if $LastD = empty or $T/SupplyDate != $LastD then
      change $G (RunDays = $G/RunDays + 1);
      set $LastD = $T/SupplyDate;
    end if;
  end loop;
  if $G != empty then
    commit $G;
  end if;

  -- slot groups: sum of the vendor groups
  retrieve $Groups from TripPlanning.VsGroup sort by Slot asc;
  declare $SG TripPlanning.SlotGroup = empty;
  set $LastS = '';
  loop $Gp in $Groups begin
    if $Gp/Slot != $LastS then
      if $SG != empty then
        commit $SG;
      end if;
      $NewSG = create TripPlanning.SlotGroup (Slot = $Gp/Slot, N = 0);
      set $SG = $NewSG;
      set $LastS = $Gp/Slot;
    end if;
    change $SG (N = $SG/N + $Gp/N);
  end loop;
  if $SG != empty then
    commit $SG;
  end if;

  -- distinct days with any trip
  retrieve $ByDay from TripPlanning.HistTrip sort by SupplyDate asc;
  declare $Days integer = 0;
  set $LastD = empty;
  loop $D in $ByDay begin
    if $LastD = empty or $D/SupplyDate != $LastD then
      set $Days = $Days + 1;
      set $LastD = $D/SupplyDate;
    end if;
  end loop;

  -- bay usage per vendor + slot + bay
  retrieve $Stops from TripPlanning.HistStop sort by Vendor asc, Slot asc, Bay asc;
  declare $BS TripPlanning.BayShare = empty;
  declare $LastB string = '';
  set $LastV = '';
  set $LastS = '';
  loop $St in $Stops begin
    if $St/Vendor != $LastV or $St/Slot != $LastS or $St/Bay != $LastB then
      if $BS != empty then
        commit $BS;
      end if;
      $NewBS = create TripPlanning.BayShare (Vendor = $St/Vendor, Slot = $St/Slot, Bay = $St/Bay);
      set $BS = $NewBS;
      set $LastV = $St/Vendor;
      set $LastS = $St/Slot;
      set $LastB = $St/Bay;
    end if;
    change $BS (
      Visits = $BS/Visits + 1,
      QtyAll = $BS/QtyAll + $St/QtyAll,
      QtyStd = $BS/QtyStd + $St/QtyStd,
      HasCritical = $BS/HasCritical or $St/HasCritical
    );
  end loop;
  if $BS != empty then
    commit $BS;
  end if;
  return $Days;
end;

/** Step 3: one VendorSlotPlan per vendor + slot, with its ordered PlanStops,
 *  and a PlanRunLog line explaining every decision. */
create microflow TripPlanning.SUB_WritePlans (
  $Settings: TripPlanning.PlanSettings,
  $Version: integer,
  $AllDays: integer
)
returns integer as $Written
folder 'Plan'
begin
  retrieve $Groups from TripPlanning.VsGroup sort by Vendor asc, Slot asc;
  declare $Written integer = 0;
  declare $Runs integer = 0;
  declare $Own boolean = false;
  declare $Np integer = 0;
  declare $Safe integer = 0;
  declare $Hard integer = 0;
  declare $Seq integer = 0;
  declare $Mins integer = 0;
  declare $MinsBasis string = '';
  declare $Scope string = '';
  declare $BasisText string = '';

  loop $Gp in $Groups begin
    set $Scope = $Gp/Vendor + ' | ' + $Gp/Slot;
    set $Runs = round(100.0 * $Gp/RunDays / $AllDays);
    if $Runs < $Settings/MinRunPct then
      call microflow TripPlanning.SUB_RunLog (
        Version = $Version, Scope = $Scope,
        Message = 'Not planned: runs on ' + toString($Runs) + '% of days, below the '
          + toString($Settings/MinRunPct) + '% minimum.'
      );
    else
      set $Own = $Gp/N >= $Settings/MinTrucks;
      set $Np = $Gp/N;
      set $BasisText = 'Vendor history';
      if $Own = false then
        retrieve $SlotRow from TripPlanning.SlotGroup where [Slot = $Gp/Slot] first;
        set $Np = $SlotRow/N;
        set $BasisText = 'Slot default (few trucks)';
      end if;
      $A = call microflow TripPlanning.SUB_PercentileTrip (
        Vendor = $Gp/Vendor, Slot = $Gp/Slot, UseVendor = $Own, N = $Np, Q = $Settings/QStart);
      $B = call microflow TripPlanning.SUB_PercentileTrip (
        Vendor = $Gp/Vendor, Slot = $Gp/Slot, UseVendor = $Own, N = $Np, Q = $Settings/QStop);
      set $Safe = ceil($A / $Settings/RoundMin) * $Settings/RoundMin;
      set $Hard = ceil(($B + $Settings/GraceMin) / $Settings/RoundMin) * $Settings/RoundMin;

      $SafeText = call microflow TripPlanning.SUB_ClockText (Slot = $Gp/Slot, Offset = $Safe);
      $HardText = call microflow TripPlanning.SUB_ClockText (Slot = $Gp/Slot, Offset = $Hard);
      $Plan = create TripPlanning.VendorSlotPlan (
        Vendor = $Gp/Vendor,
        Slot = $Gp/Slot,
        DayOfWeek = 'All',
        SafeStartOffset = $Safe,
        HardStopOffset = $Hard,
        SafeStart = $SafeText,
        HardStop = $HardText,
        Basis = $BasisText,
        TrucksInHistory = $Gp/N,
        RunsPct = $Runs,
        PlanVersion = $Version,
        GeneratedOn = [%CurrentDateTime%],
        IsActive = true
      );
      commit $Plan;
      set $Written = $Written + 1;
      call microflow TripPlanning.SUB_RunLog (
        Version = $Version, Scope = $Scope,
        Message = $BasisText + ', ' + toString($Gp/N) + ' own trucks, runs on ' + toString($Runs)
          + '% of days. P' + toString(round(100 * $Settings/QStart)) + ' = ' + toString(round($A))
          + ' min -> safe start ' + $SafeText + '; P' + toString(round(100 * $Settings/QStop))
          + ' = ' + toString(round($B)) + ' min + ' + toString($Settings/GraceMin)
          + ' grace -> hard stop ' + $HardText + '.'
      );

      -- bays: used on at least 10% of trips, top 5, critical first
      retrieve $Shares from TripPlanning.BayShare
        where [Vendor = $Gp/Vendor and Slot = $Gp/Slot]
        sort by HasCritical desc, Visits desc;
      set $Seq = 0;
      loop $Sh in $Shares begin
        if $Seq < 5 and 100.0 * $Sh/Visits / $Gp/N >= 10 then
          set $Seq = $Seq + 1;
          if $Sh/QtyAll > 0 and $Sh/QtyStd / $Sh/QtyAll >= 0.5 then
            $Raw = call microflow TripPlanning.SUB_PercentileStop (
              Vendor = $Gp/Vendor, Slot = $Gp/Slot, Bay = $Sh/Bay, N = $Sh/Visits, Q = $Settings/QStopMinutes);
            set $Mins = ceil(($Raw * (1 + $Settings/AllowancePct / 100.0) + $Settings/FixedMin) / 5) * 5;
            set $MinsBasis = 'Your standard';
          else
            set $Mins = $Settings/ManualMin;
            set $MinsBasis = 'Manual (no standard)';
          end if;
          $Stop = create TripPlanning.PlanStop (
            Sequence = $Seq,
            BayCode = $Sh/Bay,
            StopMinutes = $Mins,
            MinutesBasis = $MinsBasis,
            IsCritical = $Sh/HasCritical,
            SharePct = round(100.0 * $Sh/Visits / $Gp/N)
          );
          change $Stop (PlanStop_VendorSlotPlan = $Plan);
          retrieve $BayObj from TripPlanning.Bay where [Code = $Sh/Bay] first;
          if $BayObj != empty then
            change $Stop (PlanStop_Bay = $BayObj);
          end if;
          commit $Stop;
        end if;
      end loop;
    end if;
  end loop;
  return $Written;
end;

/** Retire the active plan, then rebuild: history -> groups -> plan rows. */
create microflow TripPlanning.SE_GeneratePlan ()
folder 'Plan'
begin
  $Cfg = call microflow TripPlanning.SUB_GetSettings ();

  retrieve $Last from TripPlanning.VendorSlotPlan sort by PlanVersion desc limit 1;
  declare $LastPlan TripPlanning.VendorSlotPlan = head($Last);
  declare $Version integer = 1;
  if $LastPlan != empty then
    set $Version = $LastPlan/PlanVersion + 1;
  end if;

  retrieve $Active from TripPlanning.VendorSlotPlan where [IsActive = true];
  loop $Old in $Active begin
    change $Old (IsActive = false);
  end loop;
  commit $Active;

  $Kept = call microflow TripPlanning.SUB_BuildHistory (Settings = $Cfg, Version = $Version);
  $AllDays = call microflow TripPlanning.SUB_BuildGroups ();
  if $AllDays > 0 then
    $Written = call microflow TripPlanning.SUB_WritePlans (Settings = $Cfg, Version = $Version, AllDays = $AllDays);
    log info node 'TripPlanning' 'Plan version {1}: {2} plan rows' with ({1} = toString($Version), {2} = toString($Written));
  else
    call microflow TripPlanning.SUB_RunLog (Version = $Version, Scope = 'run', Message = 'No usable trips: nothing planned.');
  end if;
  return;
end;

/** Same as the scheduled event, for a button on the settings page. */
create microflow TripPlanning.ACT_GeneratePlanNow ()
folder 'Plan'
begin
  call microflow TripPlanning.SE_GeneratePlan ();
  return;
end;

create scheduled event TripPlanning.WeeklyPlan (
  Microflow: TripPlanning.SE_GeneratePlan,
  Repeat: Weekly,
  Weekdays: 'Sunday',
  HourOfDay: 22,
  MinuteOfHour: 0,
  TimeZone: Server,
  OnOverlap: SkipNext,
  Enabled: false
);
