mdl 1;
-- =============================================================================
-- TripPlanning pages: see what the plan and the live allocation are doing, and why.
-- Run after tripplanning.mdl and tripplanning_live.mdl. Uses Atlas_Core layouts
-- (part of a standard Mendix app).
--
--   mxcli check "mendix\tripplanning_pages.mdl"
--   mxcli exec  "mendix\tripplanning_pages.mdl" -p "<your .mpr>"
--
-- Open TripPlanning.Home_TripPlanning: it links to every other page. To reach it,
-- set it as the home page or add one menu item for it in Studio Pro (this script does
-- not touch your navigation, so it cannot overwrite an existing menu).
-- =============================================================================

-- MARK: HELPER MICROFLOWS ----------------------------------------------------

create microflow TripPlanning.ACT_ItemStandard_New ()
folder 'Pages'
begin
  $Item = create TripPlanning.ItemStandard (Basis = 'per pack', IsCritical = false);
  show page TripPlanning.ItemStandard_Edit ($ItemStandard = $Item);
  return;
end;

create microflow TripPlanning.ACT_Bay_New ()
folder 'Pages'
begin
  $Bay = create TripPlanning.Bay (IsHotLane = false, Occupied = false);
  show page TripPlanning.Bay_Edit ($Bay = $Bay);
  return;
end;

create microflow TripPlanning.ACT_BayFallback_New ()
folder 'Pages'
begin
  $Fb = create TripPlanning.BayFallback (Rank = 1);
  show page TripPlanning.BayFallback_Edit ($BayFallback = $Fb);
  return;
end;

-- MARK: HUB ------------------------------------------------------------------

/** Start here: every page, grouped by what you want to know */
create page TripPlanning.Home_TripPlanning folder 'Hub'
(
  Title: 'Trip planning',
  Layout: Atlas_Core.Atlas_Default
)
{
  dynamictext txtIntro (Content: 'Plan: when each vendor should arrive and which bays it uses. Live: where each truck is sent and why.')
  layoutgrid gridHub {
    row {
      column {
        dynamictext txtPlanH (Content: '1. Plan')
        actionbutton btnRun (Caption: 'Generate plan now', Action: call microflow TripPlanning.ACT_GeneratePlanNow, ButtonStyle: Primary)
        actionbutton btnPlan (Caption: 'Active plan', Action: show page TripPlanning.Plan_Overview)
        actionbutton btnWhy (Caption: 'Why this plan (run log)', Action: show page TripPlanning.PlanRun_Log)
        actionbutton btnHist (Caption: 'All plan versions', Action: show page TripPlanning.Plan_History)
      }
      column {
        dynamictext txtLiveH (Content: '2. Live')
        actionbutton btnTower (Caption: 'Control tower', Action: show page TripPlanning.Control_Tower, ButtonStyle: Primary)
        actionbutton btnTrips (Caption: 'All trips', Action: show page TripPlanning.Trips_Board)
        actionbutton btnBays (Caption: 'Bays', Action: show page TripPlanning.Bays_Board)
        actionbutton btnAlloc (Caption: 'Allocations', Action: show page TripPlanning.Allocations_Log)
        actionbutton btnDec (Caption: 'Why each truck went where (decisions)', Action: show page TripPlanning.DecisionLog_Page)
        actionbutton btnExc (Caption: 'Exceptions', Action: show page TripPlanning.Exceptions_Log)
      }
      column {
        dynamictext txtSetH (Content: '3. Inputs')
        actionbutton btnSet (Caption: 'Plan settings', Action: show page TripPlanning.Settings_Overview)
        actionbutton btnItem (Caption: 'Item standards', Action: show page TripPlanning.ItemStandard_Overview)
        actionbutton btnBayList (Caption: 'Bay list', Action: show page TripPlanning.Bays_Board)
        actionbutton btnFb (Caption: 'Fallback bays', Action: show page TripPlanning.BayFallback_Overview)
        actionbutton btnGate (Caption: 'Gate-entry history', Action: show page TripPlanning.GateEntry_Overview)
      }
      column {
        dynamictext txtDbgH (Content: '4. Troubleshooting')
        actionbutton btnDrops (Caption: 'Entries left out of the plan', Action: show page TripPlanning.HistDrop_View)
        actionbutton btnHT (Caption: 'Trips used by the plan', Action: show page TripPlanning.HistTrip_View)
        actionbutton btnHS (Caption: 'Bay stops used by the plan', Action: show page TripPlanning.HistStop_View)
        actionbutton btnGr (Caption: 'Vendor-slot groups', Action: show page TripPlanning.VsGroup_View)
        actionbutton btnBS (Caption: 'Bay usage per vendor-slot', Action: show page TripPlanning.BayShare_View)
      }
    }
  }
};

-- MARK: PLAN -----------------------------------------------------------------

/** The plan in force: generate, then open a row to see its bays and minutes */
create page TripPlanning.Plan_Overview folder 'Plan'
(
  Title: 'Active trip plan',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgPlan (
    DataSource: database from TripPlanning.VendorSlotPlan where [IsActive = true] sort by Slot asc,
    PageSize: 30
  ) {
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: SafeStart, Caption: 'Safe start')
    column (Attribute: HardStop, Caption: 'Hard stop')
    column (Attribute: Basis, Caption: 'Based on')
    column (Attribute: TrucksInHistory, Caption: 'Trucks')
    column (Attribute: RunsPct, Caption: 'Runs % of days')
    column (Attribute: PlanVersion, Caption: 'Version')
    controlbar {
      actionbutton btnGen (Caption: 'Generate plan now', Action: call microflow TripPlanning.ACT_GeneratePlanNow, ButtonStyle: Primary)
      actionbutton btnOpen (Caption: 'Open bays and stops', Action: show page TripPlanning.Plan_Detail)
      actionbutton btnWhy (Caption: 'Why this plan?', Action: show page TripPlanning.PlanRun_Log)
    }
  }
};

/** Every version ever generated */
create page TripPlanning.Plan_History folder 'Plan'
(
  Title: 'All plan versions',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgHist (
    DataSource: database from TripPlanning.VendorSlotPlan sort by PlanVersion desc,
    PageSize: 40
  ) {
    column (Attribute: PlanVersion, Caption: 'Version')
    column (Attribute: GeneratedOn, Caption: 'Generated')
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: SafeStart, Caption: 'Safe start')
    column (Attribute: HardStop, Caption: 'Hard stop')
    column (Attribute: IsActive, Caption: 'Active')
    controlbar {
      actionbutton btnOpen (Caption: 'Open bays and stops', Action: show page TripPlanning.Plan_Detail)
    }
  }
};

/** One plan row with its ordered bay stops and minutes per stop */
create page TripPlanning.Plan_Detail folder 'Plan'
(
  Params: ( $Plan: TripPlanning.VendorSlotPlan ),
  Title: 'Plan detail',
  Layout: Atlas_Core.Atlas_Default
)
{
  dataview dvPlan (DataSource: $Plan) {
    layoutgrid gridPlan {
      row {
        column {
          textbox txtVendor (Label: 'Vendor', Attribute: Vendor, Editable: never)
          textbox txtSlot (Label: 'Slot', Attribute: Slot, Editable: never)
          textbox txtVersion (Label: 'Version', Attribute: PlanVersion, Editable: never)
        }
        column {
          textbox txtSafe (Label: 'Safe start', Attribute: SafeStart, Editable: never)
          textbox txtHard (Label: 'Hard stop (withdraw slot)', Attribute: HardStop, Editable: never)
          textbox txtBasis (Label: 'Based on', Attribute: Basis, Editable: never)
        }
      }
    }
    footer {
      actionbutton btnBack (Caption: 'Back', Action: close page)
    }
  }
  datagrid dgStops (
    DataSource: database from TripPlanning.PlanStop
      where [TripPlanning.PlanStop_VendorSlotPlan = $Plan]
      sort by Sequence asc,
    PageSize: 10
  ) {
    column (Attribute: Sequence, Caption: 'Stop')
    column (Attribute: BayCode, Caption: 'Bay')
    column (Attribute: StopMinutes, Caption: 'Minutes')
    column (Attribute: MinutesBasis, Caption: 'Minutes based on')
    column (Attribute: IsCritical, Caption: 'Critical')
    column (Attribute: SharePct, Caption: '% of trips')
  }
};

/** The explanation behind every plan row, bay and minute figure */
create page TripPlanning.PlanRun_Log folder 'Plan'
(
  Title: 'Why this plan',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgRun (
    DataSource: database from TripPlanning.PlanRunLog sort by RunAt desc,
    PageSize: 50
  ) {
    column (Attribute: RunAt, Caption: 'When')
    column (Attribute: PlanVersion, Caption: 'Version')
    column (Attribute: Scope, Caption: 'Vendor | slot | bay')
    column (Attribute: Message, Caption: 'What happened')
  }
};

-- MARK: LIVE -----------------------------------------------------------------

/** What needs attention now: waiting, hot, at a bay, withdrawn today */
create page TripPlanning.Control_Tower folder 'Live'
(
  Title: 'Control tower',
  Layout: Atlas_Core.Atlas_Default
)
{
  layoutgrid gridTower {
    row {
      column {
        dynamictext txtHot (Content: 'HOT: no free fallback, handle first')
        datagrid dgHot (
          DataSource: database from TripPlanning.Trip where [Status = 'Hot'] sort by GateIn asc,
          PageSize: 10
        ) {
          column (Attribute: GateIn, Caption: 'Gate in')
          column (Attribute: TruckId, Caption: 'Truck')
          column (Attribute: Vendor, Caption: 'Vendor')
          column (Attribute: Slot, Caption: 'Slot')
        }
      }
      column {
        dynamictext txtWait (Content: 'Waiting in the yard (before safe start)')
        datagrid dgWait (
          DataSource: database from TripPlanning.Trip where [Status = 'Waiting'] sort by GateIn asc,
          PageSize: 10
        ) {
          column (Attribute: GateIn, Caption: 'Gate in')
          column (Attribute: TruckId, Caption: 'Truck')
          column (Attribute: Vendor, Caption: 'Vendor')
          column (Attribute: Slot, Caption: 'Slot')
        }
      }
    }
    row {
      column {
        dynamictext txtAt (Content: 'At a bay now')
        datagrid dgAt (
          DataSource: database from TripPlanning.Trip where [Status = 'AtBay'] sort by GateIn asc,
          PageSize: 10
        ) {
          column (Attribute: GateIn, Caption: 'Gate in')
          column (Attribute: TruckId, Caption: 'Truck')
          column (Attribute: Vendor, Caption: 'Vendor')
          column (Attribute: NextSeq, Caption: 'Next stop #')
        }
      }
      column {
        dynamictext txtWd (Content: 'Withdrawn today')
        datagrid dgWd (
          DataSource: database from TripPlanning.Trip
            where [Status = 'Withdrawn' and GateIn >= [%BeginOfCurrentDay%]]
            sort by GateIn desc,
          PageSize: 10
        ) {
          column (Attribute: GateIn, Caption: 'Gate in')
          column (Attribute: TruckId, Caption: 'Truck')
          column (Attribute: Vendor, Caption: 'Vendor')
          column (Attribute: Slot, Caption: 'Slot')
        }
      }
    }
    row {
      column {
        dynamictext txtRecent (Content: 'Latest decisions, with the reason')
        datagrid dgRecent (
          DataSource: database from TripPlanning.DecisionLog sort by LoggedAt desc,
          PageSize: 10
        ) {
          column (Attribute: LoggedAt, Caption: 'When')
          column (Attribute: TruckId, Caption: 'Truck')
          column (Attribute: Step, Caption: 'Step')
          column (Attribute: Message, Caption: 'Why')
        }
      }
    }
  }
};

create page TripPlanning.Trips_Board folder 'Live'
(
  Title: 'All trips',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgTrips (
    DataSource: database from TripPlanning.Trip sort by GateIn desc,
    PageSize: 50
  ) {
    column (Attribute: GateIn, Caption: 'Gate in')
    column (Attribute: TruckId, Caption: 'Truck')
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: Status, Caption: 'Status')
    column (Attribute: NextSeq, Caption: 'Next stop #')
  }
};

/** Bay state: occupied by the feed, held by an allocation; also where bays are set up */
create page TripPlanning.Bays_Board folder 'Live'
(
  Title: 'Bays',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgBays (
    DataSource: database from TripPlanning.Bay sort by Code asc,
    PageSize: 60
  ) {
    column (Attribute: Code, Caption: 'Bay')
    column (Attribute: IsHotLane, Caption: 'Hot lane')
    column (Attribute: Occupied, Caption: 'Occupied')
    column (Attribute: ReservedUntil, Caption: 'Held until')
    controlbar {
      actionbutton btnNew (Caption: 'New bay', Action: call microflow TripPlanning.ACT_Bay_New, ButtonStyle: Primary)
      actionbutton btnEdit (Caption: 'Edit', Action: show page TripPlanning.Bay_Edit)
    }
  }
};

create page TripPlanning.Bay_Edit folder 'Live'
(
  Params: ( $Bay: TripPlanning.Bay ),
  Title: 'Bay',
  Layout: Atlas_Core.PopupLayout
)
{
  dataview dvBay (DataSource: $Bay) {
    textbox txtCode (Label: 'Bay code', Attribute: Code)
    checkbox cbHot (Label: 'Hot-lane bay', Attribute: IsHotLane)
    footer {
      actionbutton btnSave (Caption: 'Save', Action: save changes, ButtonStyle: Primary)
      actionbutton btnCancel (Caption: 'Cancel', Action: cancel changes)
    }
  }
};

create page TripPlanning.Allocations_Log folder 'Live'
(
  Title: 'Allocations',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgAlloc (
    DataSource: database from TripPlanning.Allocation sort by Start desc,
    PageSize: 50
  ) {
    column (Attribute: Start, Caption: 'Sent at')
    column (Attribute: ExpectedEnd, Caption: 'Expected end')
    column (Attribute: ActualEnd, Caption: 'Actual end')
    column (Attribute: Swapped, Caption: 'Moved to fallback')
    column (Attribute: Reason, Caption: 'Reason')
  }
};

/** Plain-words reasoning for every truck movement */
create page TripPlanning.DecisionLog_Page folder 'Live'
(
  Title: 'Why each truck went where',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgDec (
    DataSource: database from TripPlanning.DecisionLog sort by LoggedAt desc,
    PageSize: 50
  ) {
    column (Attribute: LoggedAt, Caption: 'When')
    column (Attribute: TruckId, Caption: 'Truck')
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: Step, Caption: 'Step')
    column (Attribute: Message, Caption: 'Reasoning')
  }
};

create page TripPlanning.Exceptions_Log folder 'Live'
(
  Title: 'Exceptions',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgExc (
    DataSource: database from TripPlanning.ExceptionLog sort by LoggedAt desc,
    PageSize: 50
  ) {
    column (Attribute: LoggedAt, Caption: 'When')
    column (Attribute: ExceptionType, Caption: 'Type')
    column (Attribute: Reason, Caption: 'Reason')
  }
};

-- MARK: INPUTS ---------------------------------------------------------------

create page TripPlanning.Settings_Overview folder 'Setup'
(
  Title: 'Plan settings',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgSet (DataSource: database TripPlanning.PlanSettings) {
    column (Attribute: HistoryWeeks, Caption: 'History (weeks)')
    column (Attribute: QStart, Caption: 'Safe start percentile')
    column (Attribute: QStop, Caption: 'Hard stop percentile')
    column (Attribute: GraceMin, Caption: 'Grace (min)')
    column (Attribute: MinTrucks, Caption: 'Min trucks')
    column (Attribute: MinRunPct, Caption: 'Min runs %')
    column (Attribute: ManualMin, Caption: 'Manual min/stop')
    controlbar {
      actionbutton btnEdit (Caption: 'Edit', Action: show page TripPlanning.Settings_Edit, ButtonStyle: Primary)
    }
  }
};

create page TripPlanning.Settings_Edit folder 'Setup'
(
  Params: ( $Settings: TripPlanning.PlanSettings ),
  Title: 'Plan settings',
  Layout: Atlas_Core.PopupLayout
)
{
  dataview dvSet (DataSource: $Settings) {
    textbox txtHist (Label: 'History (weeks)', Attribute: HistoryWeeks)
    textbox txtQStart (Label: 'Safe start percentile (0.80 = P80)', Attribute: QStart)
    textbox txtQStop (Label: 'Hard stop percentile (0.95 = P95)', Attribute: QStop)
    textbox txtGrace (Label: 'Grace after hard stop (min)', Attribute: GraceMin)
    textbox txtRound (Label: 'Round to (min)', Attribute: RoundMin)
    textbox txtMinT (Label: 'Min trucks for own timing', Attribute: MinTrucks)
    textbox txtMinR (Label: 'Min % of days a vendor runs', Attribute: MinRunPct)
    textbox txtAllow (Label: 'Allowance %', Attribute: AllowancePct)
    textbox txtFixed (Label: 'Fixed minutes per stop', Attribute: FixedMin)
    textbox txtQMin (Label: 'Stop minutes percentile', Attribute: QStopMinutes)
    textbox txtManual (Label: 'Manual minutes per stop', Attribute: ManualMin)
    textbox txtGap (Label: 'Gap between stops (min)', Attribute: GapMin)
    textbox txtEarly (Label: 'Ignore arrivals earlier than (h before slot)', Attribute: EarlyCapH)
    textbox txtLate (Label: 'Ignore arrivals later than (h after slot)', Attribute: LateCapH)
    footer {
      actionbutton btnSave (Caption: 'Save', Action: save changes, ButtonStyle: Primary)
      actionbutton btnCancel (Caption: 'Cancel', Action: cancel changes)
    }
  }
};

create page TripPlanning.ItemStandard_Overview folder 'Setup'
(
  Title: 'Item standards',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgItems (
    DataSource: database from TripPlanning.ItemStandard sort by Item asc,
    PageSize: 30
  ) {
    column (Attribute: Item, Caption: 'Item')
    column (Attribute: PackSize, Caption: 'Pack size')
    column (Attribute: StdMinutes, Caption: 'Std minutes')
    column (Attribute: Basis, Caption: 'Per')
    column (Attribute: IsCritical, Caption: 'Critical')
    controlbar {
      actionbutton btnNew (Caption: 'New item', Action: call microflow TripPlanning.ACT_ItemStandard_New, ButtonStyle: Primary)
      actionbutton btnEdit (Caption: 'Edit', Action: show page TripPlanning.ItemStandard_Edit)
    }
  }
};

create page TripPlanning.ItemStandard_Edit folder 'Setup'
(
  Params: ( $ItemStandard: TripPlanning.ItemStandard ),
  Title: 'Item standard',
  Layout: Atlas_Core.PopupLayout
)
{
  dataview dvItem (DataSource: $ItemStandard) {
    textbox txtItem (Label: 'Item', Attribute: Item)
    textbox txtPack (Label: 'Pack size', Attribute: PackSize)
    textbox txtStd (Label: 'Standard unloading minutes', Attribute: StdMinutes)
    textbox txtBasis (Label: 'Per (per pack / per piece / per stop)', Attribute: Basis)
    checkbox cbCrit (Label: 'Critical part', Attribute: IsCritical)
    footer {
      actionbutton btnSave (Caption: 'Save', Action: save changes, ButtonStyle: Primary)
      actionbutton btnCancel (Caption: 'Cancel', Action: cancel changes)
    }
  }
};

/** Fallback bays: one row per bay and fallback, nearest first */
create page TripPlanning.BayFallback_Overview folder 'Setup'
(
  Title: 'Fallback bays',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgFb (
    DataSource: database from TripPlanning.BayFallback sort by BayCode asc, Rank asc,
    PageSize: 60
  ) {
    column (Attribute: BayCode, Caption: 'Bay')
    column (Attribute: Rank, Caption: 'Order')
    column (Attribute: FallbackCode, Caption: 'Fallback bay')
    controlbar {
      actionbutton btnNew (Caption: 'New fallback', Action: call microflow TripPlanning.ACT_BayFallback_New, ButtonStyle: Primary)
      actionbutton btnEdit (Caption: 'Edit', Action: show page TripPlanning.BayFallback_Edit)
      actionbutton btnDelete (Caption: 'Delete', Action: delete, ButtonStyle: Danger)
    }
  }
};

create page TripPlanning.BayFallback_Edit folder 'Setup'
(
  Params: ( $BayFallback: TripPlanning.BayFallback ),
  Title: 'Fallback bay',
  Layout: Atlas_Core.PopupLayout
)
{
  dataview dvFb (DataSource: $BayFallback) {
    textbox txtBay (Label: 'Bay', Attribute: BayCode)
    textbox txtFb (Label: 'Fallback bay', Attribute: FallbackCode)
    textbox txtRank (Label: 'Order (1 = nearest)', Attribute: Rank)
    footer {
      actionbutton btnSave (Caption: 'Save', Action: save changes, ButtonStyle: Primary)
      actionbutton btnCancel (Caption: 'Cancel', Action: cancel changes)
    }
  }
};

/** Loaded history the plan is built from, read-only */
create page TripPlanning.GateEntry_Overview folder 'Setup'
(
  Title: 'Gate-entry history',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgGate (
    DataSource: database from TripPlanning.GateEntry sort by SupplyDate desc,
    PageSize: 50
  ) {
    column (Attribute: SupplyDate, Caption: 'Supply date')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: TruckId, Caption: 'Truck')
    column (Attribute: GateIn, Caption: 'Gate in')
    column (Attribute: Bay, Caption: 'Bay')
    column (Attribute: Item, Caption: 'Item')
    column (Attribute: ReceivedQty, Caption: 'Received')
  }
};

-- MARK: TROUBLESHOOTING: what the last plan run worked with ------------------

create page TripPlanning.HistDrop_View folder 'Debug'
(
  Title: 'Entries left out of the plan',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgDrop (
    DataSource: database from TripPlanning.HistDrop sort by SupplyDate desc,
    PageSize: 50
  ) {
    column (Attribute: SupplyDate, Caption: 'Supply date')
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: TruckId, Caption: 'Truck')
    column (Attribute: GateIn, Caption: 'Gate in')
    column (Attribute: OffsetMin, Caption: 'Min from slot')
    column (Attribute: Reason, Caption: 'Why left out')
  }
};

create page TripPlanning.HistTrip_View folder 'Debug'
(
  Title: 'Trips used by the plan',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgHT (
    DataSource: database from TripPlanning.HistTrip sort by SupplyDate desc,
    PageSize: 50
  ) {
    column (Attribute: SupplyDate, Caption: 'Supply date')
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: TruckId, Caption: 'Truck')
    column (Attribute: GateIn, Caption: 'Gate in')
    column (Attribute: OffsetMin, Caption: 'Min from slot')
  }
};

create page TripPlanning.HistStop_View folder 'Debug'
(
  Title: 'Bay stops used by the plan',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgHS (
    DataSource: database from TripPlanning.HistStop sort by Vendor asc,
    PageSize: 50
  ) {
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: Bay, Caption: 'Bay')
    column (Attribute: StdMin, Caption: 'Standard min')
    column (Attribute: QtyAll, Caption: 'Qty')
    column (Attribute: QtyStd, Caption: 'Qty with a standard')
    column (Attribute: HasCritical, Caption: 'Critical')
  }
};

create page TripPlanning.VsGroup_View folder 'Debug'
(
  Title: 'Vendor-slot groups',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgGr (
    DataSource: database from TripPlanning.VsGroup sort by Vendor asc,
    PageSize: 50
  ) {
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: N, Caption: 'Trips')
    column (Attribute: RunDays, Caption: 'Days run')
  }
};

create page TripPlanning.BayShare_View folder 'Debug'
(
  Title: 'Bay usage per vendor-slot',
  Layout: Atlas_Core.Atlas_Default
)
{
  datagrid dgBS (
    DataSource: database from TripPlanning.BayShare sort by Vendor asc,
    PageSize: 50
  ) {
    column (Attribute: Vendor, Caption: 'Vendor')
    column (Attribute: Slot, Caption: 'Slot')
    column (Attribute: Bay, Caption: 'Bay')
    column (Attribute: Visits, Caption: 'Visits')
    column (Attribute: QtyAll, Caption: 'Qty')
    column (Attribute: QtyStd, Caption: 'Qty with a standard')
    column (Attribute: HasCritical, Caption: 'Critical')
  }
};
